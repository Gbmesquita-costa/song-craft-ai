NODE_ENV="development"

# Database Connection
DATABASE_URL="postgresql://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?schema=public"

# Database environments (local Docker Compose only - change for any shared environment)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USERNAME="song-craft"
POSTGRES_PASSWORD="song-craft-password"
POSTGRES_DATABASE="song-craft-database"

# Auth.js secret used to sign/encrypt session JWTs.
# Never commit a real value. Generate one (at least 32 characters) with either:
#   npx auth secret          (writes AUTH_SECRET to .env.local)
#   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-generated-secret"
