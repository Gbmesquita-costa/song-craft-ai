{
  "name": "song-craft-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "run-s database:up && run-s wait-for-postgres && run-s prisma:migrate:dev",
    "postdev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "wait-for-postgres": "tsx infra/scripts/wait-for-postgres.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "database:up": "docker compose -f compose.yaml up -d song-craft-database",
    "database:down": "docker compose -f compose.yaml down song-craft-database",
    "database:stop": "docker compose -f compose.yaml stop song-craft-database"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "npm-run-all": "^4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "stripe": "^18.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "prisma": "^6.12.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
